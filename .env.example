# Port du serveur
PORT=3000

# Chaîne de connexion MongoDB (locale avec Compass, ou Atlas)
# Exemple local : mongodb://127.0.0.1:27017/mediequip
MONGODB_URI=your_mongodb_connection_string

# Secret pour signer les JWT (longue chaîne aléatoire, jamais sur GitHub)
JWT_SECRET=replace_with_a_local_secret
JWT_EXPIRES_IN=2h

# Origine(s) du frontend React autorisée(s) par CORS (séparées par des virgules)
CLIENT_URL=http://localhost:5173

# true = seul un admin peut créer/modifier/supprimer un produit
# false = tout utilisateur connecté (JWT valide) peut le faire (énoncé strict du TP)
REQUIRE_ADMIN=true

# Compte admin créé par "npm run seed"
ADMIN_NAME=Administrateur
ADMIN_EMAIL=admin@mediequip.dz
ADMIN_PASSWORD=replace_with_a_strong_password

# OAuth2 Google (optionnel) : laisser vide pour désactiver
GOOGLE_CLIENT_ID=

# Rate limiting (valeurs de l'énoncé par défaut)
RATE_LIMIT_WINDOW_MIN=15
RATE_LIMIT_MAX=100
RATE_LIMIT_LOGIN_MAX=5
